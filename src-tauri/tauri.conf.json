{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StageDeck Remote",
  "version": "0.2.1",
  "identifier": "com.sunyunbo.stagedeck-remote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StageDeck Remote · 导播端",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640
      },
      {
        "label": "toast",
        "url": "index.html#/toast",
        "width": 380,
        "height": 120,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
